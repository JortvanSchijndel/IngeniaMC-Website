---
/**
    * LoginModal.astro
    *
    * Slide-in modal that collects a Minecraft username and validates it against
    * the Mojang / PlayerDB API via session.ts.
    *
    * "Forced" mode: when `openLoginModal(true)` is called, the backdrop click and
    * the Escape key are disabled until the user successfully identifies themselves.
    * This is used by store.astro when no username is found in localStorage.
    *
    * After a successful login:
    *   1. The session is persisted to localStorage.
    *   2. The header avatar is updated (via session.ts syncHeaderUI).
    *   3. window.refreshOwnership() is called so product buttons reflect the
    *      newly authenticated user's owned products without a page reload.
    *   4. window.renderCart() re-syncs cart button states against the new
    *      ownership data.
    */
---

<div
        id="login-modal"
        class="fixed inset-0 z-110 hidden items-center justify-center p-4"
        role="dialog"
        aria-modal="true"
        aria-labelledby="login-modal-title"
        data-forced="false"
>
    <div
            class="absolute inset-0 bg-black/80 backdrop-blur-md animate-fade-in"
            id="login-modal-backdrop"
            aria-hidden="true"
    ></div>

    <div class="relative bg-(--bg-secondary) rounded-3xl border border-(--bg-quaternary) w-full max-w-md p-8 shadow-2xl animate-modal-in">
        <h3
                id="login-modal-title"
                class="text-2xl font-black text-(--primary) mb-2 uppercase tracking-tighter"
        >
            Enter Username
        </h3>
        <p class="text-(--secondary) text-[11px] font-medium mb-6 uppercase tracking-widest opacity-60">
            Provide your Minecraft username to access the store.
        </p>

        <div class="space-y-4">
            <div class="space-y-1.5">
                <label
                        for="minecraft-username-input"
                        class="block text-(--secondary) text-[9px] font-black uppercase tracking-widest ml-1"
                >
                    Minecraft Username
                </label>
                <input
                        type="text"
                        id="minecraft-username-input"
                        placeholder="e.g. Steve"
                        maxlength="16"
                        autocomplete="off"
                        spellcheck="false"
                        class="w-full px-4 py-4 rounded-xl bg-(--bg-primary) border border-(--bg-quaternary) text-(--primary) placeholder:text-(--secondary)/30 focus:border-(--ingenia) outline-none transition-all text-sm font-bold"
                />
            </div>
            <button
                    id="submit-login"
                    class="w-full py-4 rounded-xl bg-(--ingenia) text-(--bg-primary) font-black text-[12px] uppercase tracking-widest active:scale-95 transition-all disabled:opacity-40 disabled:cursor-not-allowed"
            >
                Identify
            </button>
        </div>

        <!-- Hidden in forced mode so the intent is visually unambiguous -->
        <button
                id="login-modal-close"
                class="absolute top-4 right-4 w-8 h-8 rounded-full bg-black/40 backdrop-blur-md flex items-center justify-center text-white transition-all hover:bg-black/60"
                aria-label="Close login modal"
        >
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" aria-hidden="true">
                <path d="M18 6 6 18M6 6l12 12" />
            </svg>
        </button>
    </div>
</div>

<script>
    import { showToast, closeModal } from "../../utils/store-utils";
    import { login } from "../../utils/session";

    const USERNAME_RE = /^[a-zA-Z0-9_]{1,16}$/;

    let isForced = false;

    // Open / close

    /**
        * Opens the login modal.
        * @param force — When true, the user cannot dismiss without logging in.
        */
    function openLoginModal(force = false): void {
        const modal = document.getElementById("login-modal");
        if (!modal) return;

        isForced = force;
        modal.dataset.forced = String(force);
        modal.classList.remove("hidden");
        modal.classList.add("flex");
        document.body.style.overflow = "hidden";

        const closeBtn = document.getElementById("login-modal-close");
        if (closeBtn) closeBtn.style.display = force ? "none" : "flex";

        setTimeout(
            () =>
                (document.getElementById("minecraft-username-input") as HTMLInputElement | null)
                    ?.focus(),
            100
        );
    }

    function closeLoginModal(): void {
        if (isForced && !(window as any).getCurrentUser?.()) return;

        const modal = document.getElementById("login-modal");
        if (modal) {
            closeModal(modal);
            isForced = false;
            modal.dataset.forced = "false";
        }
    }

    // Submit

    async function handleSubmit(): Promise<void> {
        const input = document.getElementById("minecraft-username-input") as HTMLInputElement | null;
        const username = input?.value?.trim() ?? "";

        if (!username) { showToast("Enter a username.", "info"); return; }
        if (!USERNAME_RE.test(username)) {
            showToast("Only letters, numbers, and underscores (max 16).", "error");
            return;
        }

        const btn = document.getElementById("submit-login") as HTMLButtonElement | null;
        const originalText = btn?.textContent ?? "Identify";
        if (btn) { btn.disabled = true; btn.textContent = "Identifying…"; }

        try {
            const user = await login(username);

            if (user) {
                closeLoginModal();
                showToast(`Welcome, ${user.name}!`, "success");

                // Fetch ownership for the newly authenticated user and update
                // all product button states on the page.
                await (window as any).refreshOwnership?.(user.name);

                // Re-render cart so in-cart vs available button states are correct
                (window as any).renderCart?.();
            }
        } finally {
            if (btn) { btn.disabled = false; btn.textContent = originalText; }
        }
    }

    // Init

    function init(): void {
        (window as any).openLoginModal = openLoginModal;

        // Header login button
        document
            .getElementById("login-trigger")
            ?.addEventListener("click", () => openLoginModal(false));

        // Clicking the avatar opens login (allows switching account)
        document
            .getElementById("user-display")
            ?.addEventListener("click", () => openLoginModal(false));

        // Logout clears session and cart
        document.getElementById("logout-btn")?.addEventListener("click", (e) => {
            e.stopPropagation();
            (window as any).logout?.();
            (window as any).clearCart?.();
            // Reset all owned-state buttons back to their default "Buy Now" state
            (window as any).refreshOwnership?.("");
            showToast("Logged out.", "info");
        });

        document
            .getElementById("login-modal-backdrop")
            ?.addEventListener("click", () => {
                if (!isForced || (window as any).getCurrentUser?.()) closeLoginModal();
            });

        document
            .getElementById("login-modal-close")
            ?.addEventListener("click", closeLoginModal);

        document
            .getElementById("submit-login")
            ?.addEventListener("click", handleSubmit);

        document
            .getElementById("minecraft-username-input")
            ?.addEventListener("keydown", (e: KeyboardEvent) => {
                if (e.key === "Enter") handleSubmit();
            });
    }

    document.addEventListener("astro:page-load", init);
</script>