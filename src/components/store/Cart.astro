---
/**
    * Cart.astro
    *
    * Slide-in cart sidebar. Manages its own item state in sessionStorage.
    *
    * Communication with other islands:
    *   - Exposes `window.addToCart`, `window.clearCart`, `window.openCart`,
    *     `window.renderCart` for cross-island calls.
    *   - Reads `window.getCurrentUser()` from session.ts globals to gate checkout.
    */
import CartSVG from './../../assets/icons/cart.svg';
---

<div
        id="cart-sidebar"
        class="fixed top-15 right-0 h-[calc(100%-3.75rem)] w-full sm:w-100 bg-(--bg-primary) border-l border-(--bg-quaternary) shadow-2xl translate-x-full transition-transform duration-500 z-100 flex flex-col"
        aria-label="Shopping cart"
        role="complementary"
>
    <!-- Header -->
    <div class="flex items-center justify-between px-6 py-4 border-b border-(--bg-quaternary) shrink-0">
        <div class="flex items-center gap-3">
            <CartSVG stroke="var(--primary)" width="20px" height="20px" aria-hidden="true" />
            <h2 class="text-sm font-black text-(--primary) uppercase tracking-[0.15em]">Your Cart</h2>
        </div>
        <button
                id="close-cart"
                class="w-8 h-8 rounded-lg bg-(--bg-secondary) border border-(--bg-quaternary) flex items-center justify-center text-(--secondary) hover:text-white transition-all active:scale-90 group"
                aria-label="Close cart"
        >
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" class="group-hover:rotate-90 transition-transform duration-300" aria-hidden="true">
                <path d="M18 6 6 18M6 6l12 12" />
            </svg>
        </button>
    </div>

    <!-- Items -->
    <div id="cart-items" class="flex-1 overflow-y-auto px-6 py-2 divide-y divide-(--bg-quaternary)" style="scrollbar-width:none;"></div>

    <!-- Footer -->
    <div class="px-6 py-6 border-t border-(--bg-quaternary) bg-(--bg-secondary)/20 shrink-0">
        <div class="flex items-center justify-between gap-4">
            <div>
                <p class="text-(--secondary) font-black text-[8px] uppercase tracking-[0.2em] mb-0.5 opacity-60">Subtotal</p>
                <p id="cart-total" class="text-2xl font-black text-(--primary) tracking-tighter">$0.00</p>
            </div>
            <button
                    id="checkout-btn"
                    disabled
                    aria-disabled="true"
                    class="px-8 py-4 rounded-xl bg-(--ingenia) text-(--bg-primary) font-black text-[11px] uppercase tracking-widest active:scale-[0.98] transition-all disabled:opacity-20 disabled:grayscale disabled:cursor-not-allowed"
            >
                Checkout
            </button>
        </div>
    </div>
</div>

<!-- Overlay behind the cart -->
<div
        id="cart-overlay"
        class="fixed inset-0 bg-black/80 backdrop-blur-sm z-90 hidden animate-fade-in"
        aria-hidden="true"
></div>

<script>
    import {
        showToast,
        parsePrice,
        formatPrice,
        CART_STORAGE_KEY,
        type CartItem,
    } from "../../utils/store-utils";

    // ─── Error messages ────────────────────────────────────────────────────────

    const API_ERROR_MESSAGES: Record<string, string> = {
        INVALID_CONTENT_TYPE: "Bad request format.",
        INVALID_JSON: "Bad request format.",
        INVALID_BODY: "Bad request format.",
        INVALID_USERNAME: "Invalid Minecraft username.",
        CART_EMPTY: "Your cart is empty.",
        INVALID_CART_ITEM: "One or more cart items are invalid.",
        UNKNOWN_PRICE_ID: "Unknown product — please refresh the page.",
        INVALID_QUANTITY: "Invalid item quantity.",
        DUPLICATE_ITEM: "Duplicate items in cart.",
        PRODUCT_MISMATCH: "Product mismatch — please refresh the page.",
        ALREADY_OWNED: "You already own one of these items.",
        DB_ERROR: "Server error — please try again later.",
        STRIPE_ERROR: "Payment processor error — please try again.",
    };

    interface CheckoutApiResponse {
        url?: string;
        error?: string;
        detail?: unknown;
    }

    // ─── State ─────────────────────────────────────────────────────────────────

    let cart: CartItem[] = [];

    // ─── Persistence ───────────────────────────────────────────────────────────

    /**
     * Loads cart from sessionStorage. Silently resets on parse failure so a
     * corrupted entry never blocks the user.
     */
    function loadCart(): void {
        try {
            cart = JSON.parse(sessionStorage.getItem(CART_STORAGE_KEY) ?? "[]");
        } catch {
            cart = [];
        }
    }

    function saveCart(): void {
        sessionStorage.setItem(CART_STORAGE_KEY, JSON.stringify(cart));
    }

    // ─── Mutations ─────────────────────────────────────────────────────────────

    /**
     * Adds a product to the cart. Silently ignores duplicates — the "Buy Now"
     * button is disabled for in-cart items, so this is only a safety guard.
     */
    function addToCart(product: {
        id: string;
        name: string;
        price: string;
        stripePriceId: string;
        image: string;
    }): void {
        if (cart.some((i) => i.id === product.id)) return;

        cart.push({ ...product, priceValue: parsePrice(product.price) });
        saveCart();
        render();
        openCart();
        // Close any open product modal so the user sees the cart
        (window as any).closeAllModals?.();
    }

    function removeFromCart(id: string): void {
        cart = cart.filter((i) => i.id !== id);
        saveCart();
        render();
    }

    /**
     * Empties the cart entirely. Called after a successful purchase or logout.
     */
    function clearCart(): void {
        cart = [];
        saveCart();
        render();
    }

    // ─── Render ────────────────────────────────────────────────────────────────

    /**
     * Re-renders the cart sidebar contents and syncs the floating cart-count
     * badge and all "Buy Now" / "In Cart" buttons across the page.
     */
    function render(): void {
        const countEl = document.getElementById("cart-count");
        const itemsEl = document.getElementById("cart-items");
        const totalEl = document.getElementById("cart-total");
        const checkoutBtn = document.getElementById(
            "checkout-btn"
        ) as HTMLButtonElement | null;

        // Badge
        if (countEl) {
            countEl.textContent = String(cart.length);
            countEl.classList.toggle("hidden", cart.length === 0);
            countEl.classList.toggle("flex", cart.length > 0);
        }

        // Item list
        if (itemsEl) {
            if (cart.length === 0) {
                itemsEl.innerHTML = `
          <div class="flex flex-col items-center justify-center py-16 gap-3 opacity-30">
            <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <circle cx="9" cy="21" r="1"/><circle cx="20" cy="21" r="1"/>
              <path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"/>
            </svg>
            <p class="font-black text-[9px] uppercase tracking-[0.3em]">Empty</p>
          </div>`;
            } else {
                itemsEl.innerHTML = cart
                    .map(
                        (item) => `
          <div class="flex items-center gap-4 py-5">
            <div class="w-12 h-12 rounded-lg overflow-hidden shrink-0 border border-(--bg-quaternary) bg-(--bg-secondary)">
              <img src="${item.image}" alt="${item.name}" class="w-full h-full object-cover" loading="lazy" />
            </div>
            <div class="flex-1 min-w-0 flex items-center justify-between gap-4">
              <p class="text-(--primary) font-black text-[13px] uppercase tracking-tight truncate">${item.name}</p>
              <p class="text-(--ingenia) font-black text-sm shrink-0">${item.price}</p>
            </div>
            <button
              class="remove-item-btn w-8 h-8 rounded flex items-center justify-center text-(--secondary) hover:text-red-400 transition-all active:scale-90"
              data-id="${item.id}"
              aria-label="Remove ${item.name} from cart"
            >
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M18 6L17.2 18.01C17.09 19.07 16.87 19.99 16 20.8C15.59 21 15.06 21 14.01 21H9.99C8.94 21 8.41 21 8 20.8C7.635 20.62 7.334 20.34 7.133 19.99C6.906 19.59 6.871 19.07 6.801 18.01L6 6M4 6H20M16 6L15.73 5.19C15.47 4.4 15.34 4.01 15.09 3.72C14.878 3.46 14.602 3.26 14.29 3.14C13.938 3 13.523 3 12.694 3H11.306C10.477 3 10.062 3 9.71 3.14C9.398 3.26 9.122 3.46 8.907 3.72C8.664 4.01 8.533 4.4 8.271 5.19L8 6M14 10V17M10 10V17"/>
              </svg>
            </button>
          </div>`
                    )
                    .join("");

                itemsEl
                    .querySelectorAll<HTMLButtonElement>(".remove-item-btn")
                    .forEach((btn) => {
                        btn.addEventListener("click", () => {
                            if (btn.dataset.id) removeFromCart(btn.dataset.id);
                        });
                    });
            }
        }

        // Total
        if (totalEl) {
            const sum = cart.reduce((acc, i) => acc + i.priceValue, 0);
            totalEl.textContent = formatPrice(sum);
        }

        // Checkout button
        if (checkoutBtn) {
            checkoutBtn.disabled = cart.length === 0;
            checkoutBtn.setAttribute("aria-disabled", String(cart.length === 0));
        }

        syncProductButtons();
    }

    /**
     * Reflects cart state on "Buy Now" buttons across the page.
     * Products already in the cart are disabled and labelled "In Cart" to
     * prevent confusion — adding a duplicate is silently ignored but the user
     * should never be surprised by that.
     */
    function syncProductButtons(): void {
        document
            .querySelectorAll<HTMLButtonElement>(
                '.add-to-cart-btn:not([data-owned="true"])'
            )
            .forEach((btn) => {
                const inCart = cart.some((i) => i.id === btn.dataset.productId);
                btn.disabled = inCart;
                btn.textContent = inCart
                    ? "In Cart"
                    : btn.classList.contains("py-4")
                        ? "Add to Cart"
                        : "Buy Now";
                btn.style.background = inCart ? "var(--bg-quaternary)" : "";
                btn.style.color = inCart ? "var(--secondary)" : "";
            });
    }

    // ─── Sidebar open / close ──────────────────────────────────────────────────

    function openCart(): void {
        document.getElementById("cart-sidebar")?.classList.remove("translate-x-full");
        document.getElementById("cart-overlay")?.classList.remove("hidden");
        document.body.style.overflow = "hidden";
    }

    function closeCart(): void {
        document.getElementById("cart-sidebar")?.classList.add("translate-x-full");
        const overlay = document.getElementById("cart-overlay");
        overlay?.classList.add("animate-fade-out");

        setTimeout(() => {
            overlay?.classList.add("hidden");
            overlay?.classList.remove("animate-fade-out");

            // Only restore scroll if no modal is also open
            const anyModalOpen =
                document.querySelectorAll(
                    '.product-modal:not(.hidden), #login-modal:not(.hidden)'
                ).length > 0;
            if (!anyModalOpen) document.body.style.overflow = "";
        }, 300);
    }

    // ─── Checkout ──────────────────────────────────────────────────────────────

    /**
     * Submits the cart to /api/checkout and redirects to Stripe.
     *
     * The user must be logged in (checked here as a guard, though the API also
     * validates). On API errors the human-readable message from `API_ERROR_MESSAGES`
     * is shown as a toast; the raw error code is logged to console for debugging.
     */
    async function initiateCheckout(): Promise<void> {
        const user = (window as any).getCurrentUser?.();
        if (!user) {
            (window as any).openLoginModal?.();
            return;
        }

        const btn = document.getElementById(
            "checkout-btn"
        ) as HTMLButtonElement | null;
        if (!btn || btn.disabled) return;

        const originalText = btn.textContent ?? "Checkout";
        btn.disabled = true;
        btn.textContent = "Processing…";

        try {
            const res = await fetch("/api/checkout", {
                method: "POST",
                headers: { "Content-Type": "application/json" },
                body: JSON.stringify({
                    username: user.name,
                    cart: cart.map((i) => ({
                        stripePriceId: i.stripePriceId,
                        productId: i.id,
                        quantity: 1,
                    })),
                }),
            });

            const data = (await res.json()) as CheckoutApiResponse;

            if (!res.ok || !data.url) {
                const code = data.error ?? "UNKNOWN";
                if (data.detail) console.error(`[checkout] ${code}:`, data.detail);
                showToast(
                    API_ERROR_MESSAGES[code] ?? `Checkout failed (${code})`,
                    "error"
                );
                btn.disabled = false;
                btn.textContent = originalText;
                return;
            }

            // Redirect to Stripe-hosted checkout page
            window.location.href = data.url;
        } catch (err) {
            console.error("[checkout] Network error:", err);
            showToast("Network error — check your connection.", "error");
            btn.disabled = false;
            btn.textContent = originalText;
        }
    }

    // ─── Init ──────────────────────────────────────────────────────────────────

    function init(): void {
        loadCart();
        render();

        // Register globals for cross-island access
        (window as any).addToCart = addToCart;
        (window as any).clearCart = clearCart;
        (window as any).openCart = openCart;
        (window as any).renderCart = render;

        document.getElementById("cart-toggle")?.addEventListener("click", openCart);
        document.getElementById("close-cart")?.addEventListener("click", closeCart);
        document.getElementById("cart-overlay")?.addEventListener("click", closeCart);
        document
            .getElementById("checkout-btn")
            ?.addEventListener("click", initiateCheckout);
    }

    document.addEventListener("astro:page-load", init);
</script>

<style>
    #cart-items {
        scrollbar-width: none;
    }
    #cart-items::-webkit-scrollbar {
        display: none;
    }
</style>