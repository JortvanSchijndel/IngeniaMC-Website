---
/**
    * ProductModal.astro
    *
    * Side-by-side product modal.
    * - 9:16 Vertical Media (Left)
    * - Large Feature List (Right)
    * - High z-index (400+)
    * - Clean, minimal transitions
    */

import { Image } from 'astro:assets';
import type { StoreProduct } from '../../config';

interface Props {
    product: StoreProduct;
    isOwned: boolean;
}

const { product, isOwned } = Astro.props;
---

<div
        id={`modal-${product.id}`}
        class="product-modal fixed inset-0 z-[500] hidden items-center justify-center p-4"
        role="dialog"
        aria-modal="true"
        aria-labelledby={`modal-title-${product.id}`}
>
    <!-- Backdrop -->
    <div class="modal-backdrop absolute inset-0 bg-black/80 backdrop-blur-md opacity-0 animate-fade-in" aria-hidden="true"></div>

    <div class="modal-panel relative bg-(--bg-secondary) rounded-[2rem] border border-(--bg-quaternary) w-full max-w-5xl h-[80vh] overflow-hidden shadow-2xl flex animate-modal-in">
        
        <!-- Close button - moved further to corner -->
        <button
                class="modal-close absolute top-4 right-4 z-50 w-8 h-8 rounded-full bg-black/20 hover:bg-black/40 flex items-center justify-center text-white transition-all"
                aria-label="Close"
        >
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round">
                <path d="M18 6 6 18M6 6l12 12" />
            </svg>
        </button>

        <!-- Left Side: 9:16 Media - Increased width -->
        <div class="hidden sm:block w-[55%] h-full bg-black shrink-0 relative border-r border-(--bg-quaternary)">
            {product.videoUrl
                ? <video src={product.videoUrl} autoplay loop muted playsinline class="w-full h-full object-cover" />
                : <Image src={product.image} alt={product.name} class="w-full h-full object-cover" />
            }
            <div class="absolute inset-0 bg-linear-to-r from-transparent to-(--bg-secondary)/20"></div>
        </div>

        <!-- Right Side: Content - Decreased width -->
        <div class="flex-1 flex flex-col h-full bg-(--bg-secondary)">
            <!-- Header - Centered alignment -->
            <div class="px-8 pt-10 pb-6 border-b border-(--bg-quaternary) shrink-0">
                <div class="flex items-center justify-between gap-4">
                    <h3 id={`modal-title-${product.id}`} class="text-4xl font-black text-(--primary) uppercase tracking-tighter leading-none">
                        {product.name}
                    </h3>
                    <div class="text-right flex flex-col items-end justify-center">
                        <p class="text-3xl font-black text-(--ingenia) leading-none">{product.price}</p>
                        {product.originalPrice && (
                            <p class="text-(--secondary) text-sm line-through opacity-40 font-bold mt-1 leading-none">{product.originalPrice}</p>
                        )}
                    </div>
                </div>
            </div>

            <!-- Scrollable Features -->
            <div class="flex-1 overflow-y-auto px-8 py-8 custom-scrollbar">
                <h4 class="text-[11px] font-black uppercase tracking-[0.3em] text-(--secondary) mb-6 opacity-50">Package Includes</h4>
                
                <!-- Reduced spacing and removed bold -->
                <ul class="space-y-2.5" role="list">
                    {(product.detailedFeatures ?? product.features).map(feature => (
                        <li class="flex items-center gap-3">
                            <div class="w-1.5 h-1.5 rounded-full bg-(--ingenia) shrink-0 shadow-[0_0_8px_rgba(var(--ingenia-rgb),0.5)]"></div>
                            <span class="text-(--primary) text-[14px] font-medium tracking-tight opacity-90">{feature}</span>
                        </li>
                    ))}
                </ul>
            </div>

            <!-- Footer Action -->
            <div class="p-8 border-t border-(--bg-quaternary) shrink-0 bg-(--bg-secondary)">
                {isOwned ? (
                    <button
                            disabled
                            aria-disabled="true"
                            data-owned="true"
                            class="w-full py-5 rounded-2xl bg-(--bg-quaternary) text-(--secondary) font-black text-[11px] uppercase tracking-widest cursor-not-allowed opacity-50"
                    >
                        Already Owned
                    </button>
                ) : (
                    <button
                            class="add-to-cart-btn w-full py-5 rounded-2xl bg-(--ingenia) text-(--bg-primary) font-black text-[11px] uppercase tracking-widest active:scale-[0.98] transition-all hover:brightness-110 shadow-lg"
                            data-product-id={product.id}
                            data-product-name={product.name}
                            data-product-price={product.price}
                            data-stripe-price-id={product.stripePriceId}
                            data-product-image={product.image.src}
                    >
                        Add to Cart
                    </button>
                )}
            </div>
        </div>
    </div>
</div>

<style>
    .custom-scrollbar::-webkit-scrollbar {
        width: 4px;
    }
    .custom-scrollbar::-webkit-scrollbar-track {
        background: transparent;
    }
    .custom-scrollbar::-webkit-scrollbar-thumb {
        background: var(--bg-quaternary);
        border-radius: 10px;
    }

    @keyframes modal-in {
        from { opacity: 0; transform: translateY(20px); }
        to { opacity: 1; transform: translateY(0); }
    }
    
    @keyframes modal-out {
        from { opacity: 1; transform: translateY(0); }
        to { opacity: 0; transform: translateY(10px); }
    }

    @keyframes backdrop-in {
        from { opacity: 0; }
        to { opacity: 1; }
    }

    @keyframes backdrop-out {
        from { opacity: 1; }
        to { opacity: 0; }
    }

    .animate-modal-in { animation: modal-in 0.3s ease-out forwards; }
    .animate-modal-out { animation: modal-out 0.2s ease-in forwards; }
    .animate-fade-in { animation: backdrop-in 0.3s ease-out forwards; }
    .animate-fade-out { animation: backdrop-out 0.2s ease-in forwards; }
</style>