---
import Layout from "../layouts/Layout.astro";
import { Image } from 'astro:assets';
import { SOCIAL_LINKS } from "../config";
import MagicVillage from "../assets/images/magic_village.png";
import Logo from "../assets/logo.png";
import ExternalLink from "../assets/icons/external-link.svg";


---

<Layout activePage="socials">
    <div class="bg-(--bg-primary) min-h-screen flex flex-col items-center">
        <!-- Background Decor -->
        <div class="fixed inset-0 z-0">
            <div class="absolute inset-0 bg-black/60 z-10"></div>
            <Image
                src={MagicVillage}
                alt="Background"
                class="w-full h-full object-cover blur-md scale-105"
            />
        </div>

        <div class="container max-w-2xl px-6 py-20 relative z-20 flex flex-col items-center">
            <!-- Profile Header -->
            <div class="text-center mb-12">
                <div class="w-32 h-32 rounded-full border-4 border-(--ingenia) p-1 mb-6 inline-block shadow-2xl overflow-hidden bg-(--bg-secondary)">
                    <Image src={Logo} alt="IngeniaMC Logo"/>
                </div>
                <h1 class="text-4xl font-black text-(--ingenia) uppercase tracking-tighter mb-2 drop-shadow-lg">
                    IngeniaMC
                </h1>
                <p class="text-(--secondary) text-lg font-medium italic opacity-90 drop-shadow-md">
                    "A Minecraft Theme Park with a story..."
                </p>
            </div>

            <!-- Links Grid -->
            <div class="w-full space-y-4">
                {SOCIAL_LINKS.map((social) => (
                    <a
                        href={social.url}
                        target="_blank"
                        class="group relative flex items-center p-4 bg-black/40 backdrop-blur-md border border-white/10 rounded-2xl hover:bg-black/60 hover:border-white/20 transition-all duration-300 active:scale-[0.98] shadow-xl overflow-hidden"
                    >
                        <!-- Hover Color Accent -->
                        <div
                            class="absolute inset-y-0 left-0 w-1.5 opacity-0 group-hover:opacity-100 transition-opacity"
                            style={`background-color: ${social.color}`}
                        ></div>

                        <div
                            class="flex items-center justify-center w-12 h-12 rounded-xl shrink-0 transition-transform group-hover:scale-110"
                            style={`background-color: ${social.color}22`}
                        >
                            <social.icon
                                width={24}
                                height={24}
                                fill={social.color}
                                stroke={social.name === "YouTube" || social.name === "Instagram" ? "none" : undefined}
                            />
                        </div>

                        <div class="ml-5 flex-1">
                            <h2 class="text-lg font-bold text-white leading-none mb-1">{social.name}</h2>
                            <p class="text-sm text-(--secondary) opacity-70 leading-none">{social.description}</p>
                        </div>

                        <div class="mr-2 opacity-40 group-hover:opacity-100 group-hover:translate-x-1 transition-all">
                            <ExternalLink width={20} height={20} stroke="white" />
                        </div>
                    </a>
                ))}
            </div>

            <!-- Bottom Note -->
            <div class="mt-16 text-center">
                <p class="text-white/40 text-xs font-black uppercase tracking-[0.4em]">
                    play.ingeniamc.org
                </p>
            </div>
        </div>
    </div>
</Layout>
