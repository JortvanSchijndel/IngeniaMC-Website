---
import Layout from "../layouts/Layout.astro";
import { Image } from 'astro:assets';
import { DISCORD_URL, CONTACT_EMAIL } from "../config";
import MagicVillage from "../assets/images/magic_village.png";
import M64Image from "../assets/images/m64.png";
import AvontuurierImage from "../assets/images/avontuuriergamer_waving.png";
import Discord from "../assets/icons/discord.svg";
import ExternalLink from "../assets/icons/external-link.svg";
---

<Layout activePage="contact">
    <div class="bg-(--bg-primary) min-h-screen">
        <!-- Header Section -->
        <section class="relative h-[40vh] flex items-center justify-center overflow-hidden">
            <div class="absolute inset-0 z-0">
                <div class="absolute inset-0 bg-black/50 z-10"></div>
                <Image
                    src={MagicVillage}
                    alt="Contact Header"
                    class="w-full h-full object-cover scale-105 blur-sm"
                    loading="eager"
                />
                <div class="absolute inset-x-0 bottom-0 h-24 bg-linear-to-t from-(--bg-primary) to-transparent z-20"></div>
            </div>

            <div class="container mx-auto px-6 relative z-30 text-center">
                <h1 class="text-5xl md:text-7xl font-black text-white uppercase tracking-tighter mb-4 drop-shadow-2xl">
                    Get in <span class="text-(--ingenia)">Touch</span>
                </h1>
                <p class="text-(--secondary) text-xl md:text-2xl font-medium italic opacity-90">
                    We'd love to hear from you!
                </p>
            </div>
        </section>

        <!-- Contact Content -->
        <section class="py-20">
            <div class="container mx-auto px-6">
                <div class="grid grid-cols-1 lg:grid-cols-2 gap-16 items-center max-w-6xl mx-auto">
                    <!-- Contact Cards -->
                    <div class="space-y-8">
                        <div class="relative inline-block mb-4">
                            <h2 class="text-3xl md:text-4xl font-bold text-white">Contact Information</h2>
                            <div class="absolute -bottom-3 left-0 w-16 h-1 bg-(--ingenia) rounded-full"></div>
                        </div>
                        <p class="text-(--secondary) text-lg leading-relaxed">
                            Have questions about our park, want to report a bug, or just want to say hi? 
                            Reach out to us through our primary contact channels below.
                        </p>

                        <div class="grid gap-6">
                            <!-- Email Card -->
                            <div class="group bg-(--bg-secondary) p-8 rounded-2xl border border-white/5 hover:border-(--ingenia)/30 transition-all duration-300 shadow-xl">
                                <div class="flex items-center gap-6">
                                    <div class="w-14 h-14 bg-(--ingenia)/10 rounded-xl flex items-center justify-center shrink-0 group-hover:scale-110 transition-transform">
                                        <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="var(--ingenia)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="20" height="16" x="2" y="4" rx="2"/><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/></svg>
                                    </div>
                                    <div>
                                        <p class="text-(--secondary) text-xs font-black uppercase tracking-[0.2em] mb-1">Email Support</p>
                                        <a href={`mailto:${CONTACT_EMAIL}`} class="text-xl md:text-2xl font-bold text-white hover:text-(--ingenia) transition-colors break-all">
                                            {CONTACT_EMAIL}
                                        </a>
                                    </div>
                                </div>
                            </div>

                            <!-- Discord Card -->
                            <a href={DISCORD_URL} target="_blank" class="group bg-(--bg-secondary) p-8 rounded-2xl border border-white/5 hover:border-(--discord)/30 transition-all duration-300 shadow-xl">
                                <div class="flex items-center gap-6">
                                    <div class="w-14 h-14 bg-(--discord)/10 rounded-xl flex items-center justify-center shrink-0 group-hover:scale-110 transition-transform">
                                        <Discord width={28} height={28} fill="var(--discord)" />
                                    </div>
                                    <div class="flex-1">
                                        <p class="text-(--secondary) text-xs font-black uppercase tracking-[0.2em] mb-1">Community Discord</p>
                                        <p class="text-xl md:text-2xl font-bold text-white group-hover:text-(--discord) transition-colors">Join our Server</p>
                                    </div>
                                    <div class="w-10 h-10 bg-white/5 rounded-lg flex items-center justify-center group-hover:bg-white/10 transition-colors">
                                        <ExternalLink width={24} height={24} stroke="white" />
                                    </div>
                                </div>
                            </a>
                        </div>
                    </div>

                    <!-- Fun Images -->
                    <div class="relative">
                        <div class="absolute -inset-10 bg-(--ingenia)/10 blur-3xl rounded-full opacity-50"></div>
                        <div class="relative flex justify-center items-center">
                            <!-- Background decorative element -->
                            <div class="absolute w-4/5 h-4/5 bg-(--bg-tertiary) rounded-[40px_4px] transform -rotate-3 -z-10"></div>
                            
                            <div class="flex flex-row -space-x-12 md:-space-x-20">
                                <div class="relative z-10 animate-float" style="animation-delay: 0.5s;">
                                    <Image 
                                        src={M64Image} 
                                        alt="M64DiamondStar" 
                                        class="max-h-80 w-auto drop-shadow-2xl hover:scale-105 transition-transform duration-500"
                                    />
                                </div>
                                <div class="relative z-20 animate-float">
                                    <Image 
                                        src={AvontuurierImage} 
                                        alt="AvontuurierGamer waving" 
                                        class="max-h-96 w-auto drop-shadow-2xl hover:scale-105 transition-transform duration-500"
                                    />
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </section>
    </div>
</Layout>

<style>
    .animate-float {
        animation: float 6s ease-in-out infinite;
    }

    @keyframes float {
        0%, 100% { transform: translateY(0px); }
        50% { transform: translateY(-20px); }
    }
</style>
